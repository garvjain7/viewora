# Local development only. Copy this file to .env and fill values as needed.
# Do not commit .env or put real credentials here.

# PostgreSQL. Use direct connection for migrations; pooled connection for API if supported by the host.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Candidate logical endpoints for cache and short-lived state/coordination.
# Whether these require separate physical services, and which data needs durability, is open.
REDIS_CACHE_URL=
REDIS_STATE_URL=

# Cloudflare R2 S3-compatible API.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
PUBLIC_ASSET_BASE_URL=
